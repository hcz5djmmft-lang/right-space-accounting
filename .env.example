# Postgres connection. Supabase: Connect > Session pooler (port 5432), with the password filled in.
# Not the Transaction pooler (6543): it loses replies when several queries are in flight, and pages hang.
# Anything but localhost is connected over TLS; add ?sslmode=disable for another local server without it.
DATABASE_URL=postgres://postgres@localhost:5432/rsa
# Public address of the app, used in approval emails (the Vercel address until a domain exists)
APP_URL=http://localhost:3000
# Company time zone for "today" in the books
APP_TZ=Africa/Cairo
# Email sending (SMTP). Leave empty locally: emails are printed to the server log instead.
# Gmail: smtps://<address, with @ written as %40>:<app password>@smtp.gmail.com:465
SMTP_URL=
EMAIL_FROM=Right Space Accounting <accounts@example.com>
# Receipt photos. Locally they go to ./uploads. In production use a private Supabase Storage bucket:
# SUPABASE_URL = Project settings > Data API > Project URL; SUPABASE_SERVICE_KEY = the service_role key (secret)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=attachments
# Optional: a word the first-login page asks for on a fresh database, so only you can create the first login
SETUP_CODE=
# Vercel Preview environment only: lets a preview build update the tables of its own (test) database
MIGRATE_PREVIEW=
