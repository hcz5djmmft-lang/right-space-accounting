# Postgres connection (Supabase: Project settings > Database > Connection string)
DATABASE_URL=postgres://postgres@localhost:5432/rsa
# Long random string used to sign login sessions
SESSION_SECRET=change-me
# Public address of the app, used in approval emails
APP_URL=http://localhost:3000
# Email (Resend). Leave empty locally: emails are printed to the console instead.
RESEND_API_KEY=
EMAIL_FROM=Right Space Accounting <accounts@example.com>
